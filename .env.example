# 复制为 .env 后按需修改：copy .env.example .env
# 会话签名密钥（生产环境请改为随机值，例如 python -c "import secrets;print(secrets.token_urlsafe(32))"）
SECRET_KEY=sas-dev-secret-change-me

# MySQL 连接（与 docker-compose.yml 的 3307 端口对应；数据库不存在时 init_db.py 会自动创建）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3307/security_assessment?charset=utf8mb4

# LLM：OpenAI 兼容接口，默认 DeepSeek
# API Key 只从环境变量读取，系统配置页不能写入
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=300

# 离线演示：true 时返回内置结构化结果，不调用真实模型；正式评估请保持 false
LLM_MOCK=false

# 隔离环境
DOCKER_IMAGE=assessment-runner:latest
DOCKERFILE_DIR=./docker
ISOLATION_TARGET_PORT=5000
# true：Docker 不可用时拒绝启动评估；false：退化为仅静态分析
ISOLATION_REQUIRED=true
# 是否在容器内执行 PoC 动态验证
ENABLE_DYNAMIC_VERIFY=true

# 运行时默认值（也可在系统配置页修改非敏感项）
DEFAULT_TIMEOUT=3600
MAX_CONCURRENCY=3
RETENTION_DAYS=30
RESOURCE_SAMPLE_SECONDS=3
MAX_CONTEXT_CHARS=90000
MAX_READ_FILES=40

# 本地源码允许的根目录，分号分隔；为空表示开发模式不限制
# 例：ALLOWED_SOURCE_ROOTS=C:/work;C:/Users/CC/projects
ALLOWED_SOURCE_ROOTS=

# 数据目录（日志、报告、工作区）
# DATA_DIR=./data
